    <!-- ================================================================== -->
    <!-- 1. CORE DESIGN SYSTEM TOKENS (LIGHT MODE)                          -->
    <!-- ================================================================== -->

    <!-- Backgrounds & Surfaces -->
    <color name="ds_color_bg">#F2F2F4</color>
    <color name="ds_color_surface">#FFFFFF</color>
    <color name="ds_color_surface_pressed">#E8E8ED</color>
    <color name="ds_color_surface_selected">#E5EEFF</color>
    <color name="ds_color_surface_elevated">#FFFFFF</color>
    <color name="ds_color_surface_control">#E4E4E9</color>

    <!-- Dark-mode comparison tokens (aliased to light surface in light mode) -->
    <color name="ds_color_surface_opt1">#FFFFFF</color>
    <color name="ds_color_surface_opt2">#FFFFFF</color>

    <!-- Borders & Dividers -->
    <color name="ds_color_surface_border">#00000000</color>
    <color name="ds_color_divider">#E8E8EC</color>

    <!-- Typography & Icons -->
    <color name="ds_color_text_primary">#0A0A0B</color>
    <color name="ds_color_text_secondary">#5F5F68</color>
    <color name="ds_color_text_tertiary">#6B6B73</color>
    <color name="ds_color_text_disabled">#610A0A0B</color>
    <color name="ds_color_icon_primary">#0A0A0B</color>
    <color name="ds_color_icon_secondary">#5F5F68</color>
    <color name="ds_color_icon_chevron">#8E8E96</color>

    <!-- Accents & Semantic States:
         - ds_color_accent (#2F6BFF): for toggles, sliders, links, selection (4.50:1 on #FFFFFF)
         - ds_color_accent_filled (#2563EB): for filled buttons with white text (5.17:1 on #FFFFFF) -->
    <color name="ds_color_accent">#2F6BFF</color>
    <color name="ds_color_accent_pressed">#2456D6</color>
    <color name="ds_color_accent_filled">#2563EB</color>
    <color name="ds_color_accent_filled_pressed">#1D4ED8</color>
    <color name="ds_color_accent_container">#E5EEFF</color>
    <color name="ds_color_on_accent">#FFFFFF</color>
    <color name="ds_color_destructive">#D92D20</color>
    <color name="ds_color_destructive_container">#FEE4E2</color>

    <!-- Controls (Switch / Slider / Back Button) -->
    <color name="ds_color_switch_track_off">#DEDEE4</color>
    <color name="ds_color_switch_track_on">@color/ds_color_accent</color>
    <color name="ds_color_switch_thumb">#FFFFFF</color>
    <color name="ds_color_back_button_bg">#0F0A0A0B</color>
    <color name="ds_color_back_button_bg_pressed">#1F0A0A0B</color>

    <!-- Default Faint Ripple / Highlight Fallback (8% black in light mode)
         Used by dialogs, toolbar buttons, and unmigrated views; list rows use non-ripple tone shift -->
    <color name="ds_color_ripple_fallback">#14000000</color>

    <!-- Search Highlight Pulse -->
    <color name="ds_color_highlight_pulse">#262F6BFF</color>

