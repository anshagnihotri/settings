  Trailing chevron for navigation rows:
  16dp size, 1.5dp stroke (scaled to 24x24 viewport -> 2.25px strokeWidth at 16dp, or 1.5dp at 24dp),
  round caps and joins, autoMirrored for RTL.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="@dimen/ds_chevron_size"
    android:height="@dimen/ds_chevron_size"
    android:viewportWidth="24"
    android:viewportHeight="24"
    android:autoMirrored="true">
    <path
        android:pathData="M9,6L15,12L9,18"
        android:strokeWidth="2.0"
        android:strokeColor="@color/ds_color_icon_chevron"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="@android:color/transparent" />
</vector>
