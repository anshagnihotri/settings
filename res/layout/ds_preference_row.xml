  Standard Subpage Preference Row Layout:
  - Root paddingStart/End = 32dp (16dp outer screen gutter + 16dp inner card padding)
  - Icon box = 24dp (containing 22dp icon) + 12dp gap to text
  - Text & inset divider start at 52dp from card left edge (68dp from screen edge)
  - v1: summary stays below title; ds_row_value is opt-in for right-aligned values;
    ds_chevron is shown only on navigation/dialog rows with an empty widget_frame.
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="@dimen/redesign_row_height"
    android:paddingStart="@dimen/redesign_row_horizontal_padding"
    android:paddingEnd="@dimen/redesign_row_horizontal_padding"
    android:gravity="center_vertical"
    android:clipToPadding="false"
    android:baselineAligned="false">

    <include layout="@layout/settingslib_expressive_preference_icon_frame" />

    <RelativeLayout
        android:id="@+id/text_frame"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:paddingStart="0dp"
        android:paddingEnd="8dp"
        android:filterTouchesWhenObscured="false">

        <TextView
            android:id="@android:id/title"
            style="@style/TextAppearance.Redesign.Label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="start"
            android:textAlignment="viewStart"
            android:maxLines="2"
            android:ellipsize="end" />

        <TextView
            android:id="@android:id/summary"
            style="@style/TextAppearance.Redesign.Description"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@android:id/title"
            android:layout_alignStart="@android:id/title"
            android:layout_marginTop="2dp"
            android:layout_gravity="start"
            android:textAlignment="viewStart"
            android:maxLines="10" />

    </RelativeLayout>

    <!-- Opt-in right-aligned value text (for DsValuePreference or "ds_right_value" extra) -->
    <TextView
        android:id="@+id/ds_row_value"
        style="@style/TextAppearance.Redesign.Description"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:layout_marginStart="8dp"
        android:maxWidth="160dp"
        android:singleLine="true"
        android:ellipsize="end"
        android:textAlignment="viewEnd"
        android:visibility="gone" />

    <!-- Trailing chevron: shown by HighlightablePreferenceGroupAdapter only on navigation rows -->
    <ImageView
        android:id="@+id/ds_chevron"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:layout_gravity="center_vertical"
        android:layout_marginStart="8dp"
        android:src="@drawable/ds_ic_chevron_right"
        android:importantForAccessibility="no"
        android:visibility="gone" />

    <!-- Standard AndroidX Preference widget container (Switch, Radio, Checkbox, Gear, etc.) -->
    <LinearLayout
        android:id="@android:id/widget_frame"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:gravity="end|center_vertical"
        android:orientation="vertical" />

</LinearLayout>
